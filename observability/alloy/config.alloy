// Two sources, one masking pipeline:
// - the backend's log file (local run: root app.py, logs/hedis-app*.log, mounted read-only); in containers there is
//   no file and this source stays idle;
// - log records pushed by every Python process (common/app_logging.py ship_logs, ALLOY_URL) on port 3500.
// Both go through loki.process "mask" (emails, file names, OpenRouter user ids; level and logger) and on to Loki.

local.file_match "hedis" {
  path_targets = [
    {
      "__path__" = "/var/log/hedis/hedis-app*.log",
      "job"      = "hedis-api",
    },
  ]
}

loki.source.file "hedis" {
  targets    = local.file_match.hedis.targets
  forward_to = [loki.process.file.receiver]
}

// Pushed records arrive whole (traceback included), labelled job="hedis", service, level, with batch_id and job_id
// as structured metadata.
loki.source.api "push" {
  http {
    listen_address = "0.0.0.0"
    listen_port    = 3500
  }
  use_incoming_timestamp = true
  forward_to             = [loki.process.mask.receiver]
}

loki.process "file" {
  // A new entry starts with the app's timestamp; anything else (traceback lines) belongs to the entry before it.
  stage.multiline {
    firstline     = `^\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2}`
    max_wait_time = "3s"
  }

  forward_to = [loki.process.mask.receiver]
}

loki.process "mask" {
  // Prometheus scrapes /metrics every 15s; those access lines are not sent to Loki.
  stage.drop {
    expression          = `"GET /metrics HTTP/`
    drop_counter_reason = "metrics_scrape"
  }

  // Email addresses (sign-in and admin screens).
  stage.replace {
    expression = `([A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,})`
    replace    = "<email>"
  }

  // Document file names (upload names can contain a patient's name). .py paths are left alone for tracebacks.
  stage.replace {
    expression = `([^\s"'=,;()\[\]<>|]+\.(?i:pdf|png|jpg|jpeg|tif|tiff|csv|json|txt|docx))\b`
    replace    = "<file>"
  }

  // OpenRouter user ids: "user_id": "...", user_id=..., and bare user_xxxxxxxx tokens.
  stage.replace {
    expression = `"user_id"\s*:\s*"([^"]*)"`
    replace    = "<user>"
  }
  stage.replace {
    expression = `user_id=([^\s,;&"']+)`
    replace    = "<user>"
  }
  stage.replace {
    expression = `\b(user_[A-Za-z0-9]{8,})\b`
    replace    = "<user>"
  }

  // "2026-10-30 10:15:02,123 ERROR services.integration.routes: ..." -> level label, logger as structured metadata.
  stage.regex {
    expression = `^\S+ \S+ (?P<level>[A-Z]+) (?P<logger>[^\s:]+):`
  }
  stage.labels {
    values = { level = "" }
  }
  stage.structured_metadata {
    values = { logger = "" }
  }

  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
