      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "hedis-prometheus"
          },
          "refId": "A",
          "expr": "sum by (step) (increase(hedis_batch_step_seconds_sum[$__range])) / sum by (step) (increase(hedis_batch_step_seconds_count[$__range]))",
          "legendFormat": "{{step}}",
          "format": "table",
          "instant": true,
          "range": false
        }
