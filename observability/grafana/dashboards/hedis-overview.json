    {
      "id": 11,
      "type": "timeseries",
      "title": "Step time p95",
      "description": "95th percentile duration of each batch step.",
      "datasource": {
        "type": "prometheus",
        "uid": "hedis-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "hedis-prometheus"
          },
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, step) (rate(hedis_batch_step_seconds_bucket[$__rate_interval])))",
          "legendFormat": "{{step}}",
          "instant": false,
          "range": true
        }
      ]
    },
    {
      "id": 12,
      "type": "barchart",
      "title": "Average time per step (range)",
      "description": "Average duration of each batch step over the selected time range.",
      "datasource": {
        "type": "prometheus",
        "uid": "hedis-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
