      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "hedis-prometheus" },
          "refId": "A",
          "expr": "sum by (handler) (rate(http_requests_total{job=\"hedis-ui-backend\", status=\"5xx\"}[$__rate_interval]))",
          "legendFormat": "{{handler}}",
          "instant": false,
          "range": true
        }
      ]
    },
    {
      "id": 12,
      "type": "bargauge",
      "title": "Requests to routes app.py does not serve (range)",
      "description": "Requests to paths app.py has no route for, by method and status, in the selected time range.",
      "datasource": { "type": "prometheus", "uid": "hedis-prometheus" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 22 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": { "mode": "absolute", "steps": [ { "color": "orange", "value": null } ] }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "hedis-prometheus" },
          "refId": "A",
          "expr": "sum by (method, status) (increase(http_requests_total{job=\"hedis-ui-backend\", handler=\"none\"}[$__range]))",
          "legendFormat": "{{method}} {{status}}",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 13,
      "type": "row",
      "title": "Features",
      "collapsed": false,
