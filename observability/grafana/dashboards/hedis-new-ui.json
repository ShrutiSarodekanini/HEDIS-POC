    {
      "id": 19,
      "type": "timeseries",
      "title": "Gap automation runs by trigger and outcome",
      "description": "Gap automation runs per interval: trigger api is the Process gaps button, background is app.py's automatic worker every 30 s.",
      "datasource": { "type": "prometheus", "uid": "hedis-prometheus" },
      "interval": "5m",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 47 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "bars", "fillOpacity": 80, "lineWidth": 1, "showPoints": "never", "stacking": { "mode": "normal", "group": "A" } }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
