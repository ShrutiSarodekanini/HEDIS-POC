    {
      "id": 31,
      "type": "row",
      "title": "Run history (Postgres)",
      "collapsed": false,
      "panels": [],
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 95 }
    },
    {
      "id": 32,
      "type": "table",
      "title": "Ingestion jobs",
      "description": "Every ingestion job started in the selected time range: status, duration, record counts and issue counts.",
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "hedis-postgres" },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 96 },
      "fieldConfig": {
        "defaults": { "noValue": "No ingestion jobs" },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Duration" }, "properties": [ { "id": "unit", "value": "s" } ] },
          {
            "matcher": { "id": "byName", "options": "Status" },
            "properties": [
              { "id": "custom.cellOptions", "value": { "type": "color-background" } },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "completed": { "color": "green", "index": 0 },
                      "partially_completed": { "color": "orange", "index": 1 },
                      "failed": { "color": "red", "index": 2 },
                      "running": { "color": "blue", "index": 3 },
                      "pending": { "color": "blue", "index": 4 }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Errors" },
            "properties": [
              { "id": "custom.cellOptions", "value": { "type": "color-text" } },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 0.5 } ] } }
            ]
          }
        ]
      },
      "options": { "showHeader": true, "cellHeight": "sm", "footer": { "show": false } },
      "targets": [
        {
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "hedis-postgres" },
          "refId": "A", "format": "table", "rawQuery": true, "editorMode": "code",
          "rawSql": "SELECT started_at AS \"Started\", completed_at AS \"Completed\", extract(epoch FROM completed_at - started_at) AS \"Duration\", status AS \"Status\", total_source_records AS \"Source records\", resources_generated AS \"Generated\", resources_validated AS \"Validated\", resources_persisted AS \"Persisted\", warning_count AS \"Warnings\", error_count AS \"Errors\", id AS \"Job id\", batch_id AS \"Batch id\"\n  FROM hedis.conversion_jobs WHERE $__timeFilter(started_at) ORDER BY started_at DESC LIMIT 500"
        }
      ]
    },
    {
      "id": 33,
      "type": "table",
      "title": "Validation issues by job",
      "description": "Validation issues in the selected time range, grouped by job, severity, category, code, resource type and field.",
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "hedis-postgres" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 105 },
      "fieldConfig": {
        "defaults": { "noValue": "No validation issues" },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Severity" },
            "properties": [
              { "id": "custom.cellOptions", "value": { "type": "color-background" } },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "error": { "color": "red", "index": 0 },
                      "warning": { "color": "orange", "index": 1 },
                      "information": { "color": "blue", "index": 2 }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": { "showHeader": true, "cellHeight": "sm", "footer": { "show": false } },
      "targets": [
        {
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "hedis-postgres" },
          "refId": "A", "format": "table", "rawQuery": true, "editorMode": "code",
          "rawSql": "SELECT max(created_at) AS \"Last seen\", job_id AS \"Job id\", severity AS \"Severity\", issue_category AS \"Category\", error_code AS \"Error code\", resource_type AS \"Resource type\", field_path AS \"Field\", count(*) AS \"Issues\"\n  FROM hedis.validation_issues WHERE $__timeFilter(created_at)\n GROUP BY job_id, severity, issue_category, error_code, resource_type, field_path ORDER BY max(created_at) DESC LIMIT 500"
        }
      ]
    },
    {
      "id": 34,
      "type": "table",
      "title": "Sign-in sessions",
      "description": "Sign-in sessions started in the selected time range, by user id and role.",
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "hedis-postgres" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 113 },
      "fieldConfig": {
        "defaults": { "noValue": "No sessions" },
        "overrides": []
      },
      "options": { "showHeader": true, "cellHeight": "sm", "footer": { "show": false } },
      "targets": [
        {
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "hedis-postgres" },
          "refId": "A", "format": "table", "rawQuery": true, "editorMode": "code",
          "rawSql": "SELECT s.created_at AS \"Signed in\", s.user_id AS \"User id\", u.role AS \"Role\", s.expires_at AS \"Expires\", s.revoked_at AS \"Signed out or revoked\"\n  FROM hedis.auth_session s JOIN hedis.app_user u ON u.user_id = s.user_id WHERE $__timeFilter(s.created_at) ORDER BY s.created_at DESC LIMIT 500"
        }
      ]
    },
