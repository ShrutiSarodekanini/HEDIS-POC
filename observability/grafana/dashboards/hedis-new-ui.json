              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "approved": { "color": "green", "index": 0 },
                      "pending": { "color": "blue", "index": 1 },
                      "rejected": { "color": "red", "index": 2 }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": { "showHeader": true, "cellHeight": "sm", "footer": { "show": false } },
      "targets": [
        {
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "hedis-postgres" },
          "refId": "A", "format": "table", "rawQuery": true, "editorMode": "code",
          "rawSql": "SELECT updated_at AS \"Changed\", user_id AS \"User id\", role AS \"Role\", access_status AS \"Access\", is_active AS \"Active\", created_at AS \"Created\"\n  FROM hedis.app_user WHERE $__timeFilter(updated_at) ORDER BY updated_at DESC LIMIT 500"
        }
      ]
    },
    {
      "id": 36,
