{
  "uid": "hedis-new-ui",
  "title": "HEDIS new UI",
  "description": "The React UI's backend (root app.py) and the browser: requests, features, browser errors, logs and run history.",
  "tags": ["hedis"],
  "editable": false,
  "schemaVersion": 41,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "timezone": "browser",
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "links": [
    {
      "title": "Pipeline",
      "type": "link",
      "url": "/d/hedis-overview",
      "icon": "dashboard",
      "keepTime": true,
      "includeVars": false,
      "targetBlank": false,
      "asDropdown": false,
      "tags": [],
      "tooltip": "HEDIS pipeline metrics"
    },
    {
      "title": "Run history",
      "type": "link",
      "url": "/d/hedis-run-history",
      "icon": "dashboard",
      "keepTime": true,
      "includeVars": false,
      "targetBlank": false,
      "asDropdown": false,
      "tags": [],
      "tooltip": "Integration app run history"
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Backend",
      "collapsed": false,
      "panels": [],
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Backend up",
      "description": "Whether Prometheus can scrape the new UI's backend (root app.py).",
      "datasource": { "type": "prometheus", "uid": "hedis-prometheus" },
      "gridPos": { "h": 4, "w": 5, "x": 0, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "No data",
          "mappings": [
            { "type": "value", "options": { "1": { "text": "UP", "color": "green", "index": 0 }, "0": { "text": "DOWN", "color": "red", "index": 1 } } },
            { "type": "special", "options": { "match": "null+nan", "result": { "text": "No data", "color": "text", "index": 2 } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background", "graphMode": "none", "textMode": "value", "justifyMode": "auto", "orientation": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "hedis-prometheus" },
          "refId": "A",
          "expr": "up{job=\"hedis-ui-backend\"}",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Requests (range)",
      "description": "HTTP requests app.py answered in the selected time range, not counting Prometheus scrapes of /metrics.",
      "datasource": { "type": "prometheus", "uid": "hedis-prometheus" },
      "gridPos": { "h": 4, "w": 5, "x": 5, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "No data",
          "mappings": [ { "type": "special", "options": { "match": "null+nan", "result": { "text": "No data", "color": "text", "index": 0 } } } ],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "blue", "value": null } ] }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background", "graphMode": "none", "textMode": "value", "justifyMode": "auto", "orientation": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "hedis-prometheus" },
          "refId": "A",
          "expr": "sum(increase(http_requests_total{job=\"hedis-ui-backend\", handler!=\"/metrics\"}[$__range])) or vector(0)",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Server errors 5xx (range)",
      "description": "Requests app.py answered with a 5xx status in the selected time range.",
      "datasource": { "type": "prometheus", "uid": "hedis-prometheus" },
      "gridPos": { "h": 4, "w": 5, "x": 10, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "No data",
          "mappings": [ { "type": "special", "options": { "match": "null+nan", "result": { "text": "No data", "color": "text", "index": 0 } } } ],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 0.5 } ] }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background", "graphMode": "none", "textMode": "value", "justifyMode": "auto", "orientation": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "hedis-prometheus" },
          "refId": "A",
          "expr": "sum(increase(http_requests_total{job=\"hedis-ui-backend\", status=\"5xx\"}[$__range])) or vector(0)",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Unserved routes 404 (range)",
      "description": "Requests to paths app.py has no route for (for example /api/gaps), grouped as handler \"none\"; the log panel shows which path.",
      "datasource": { "type": "prometheus", "uid": "hedis-prometheus" },
      "gridPos": { "h": 4, "w": 5, "x": 15, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "No data",
          "mappings": [ { "type": "special", "options": { "match": "null+nan", "result": { "text": "No data", "color": "text", "index": 0 } } } ],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 0.5 } ] }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background", "graphMode": "none", "textMode": "value", "justifyMode": "auto", "orientation": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "hedis-prometheus" },
          "refId": "A",
          "expr": "sum(increase(http_requests_total{job=\"hedis-ui-backend\", handler=\"none\"}[$__range])) or vector(0)",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Browser errors (range)",
      "description": "Errors the browser reported to app.py in the selected time range.",
      "datasource": { "type": "prometheus", "uid": "hedis-prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "No data",
          "mappings": [ { "type": "special", "options": { "match": "null+nan", "result": { "text": "No data", "color": "text", "index": 0 } } } ],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 0.5 } ] }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background", "graphMode": "none", "textMode": "value", "justifyMode": "auto", "orientation": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "hedis-prometheus" },
          "refId": "A",
          "expr": "sum(increase(hedis_ui_client_errors_total[$__range])) or vector(0)",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 7,
      "type": "row",
      "title": "Requests",
      "collapsed": false,
      "panels": [],
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Requests per second by route",
      "description": "Requests per second app.py answered, by route, not counting /metrics.",
      "datasource": { "type": "prometheus", "uid": "hedis-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never", "spanNulls": false }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "hedis-prometheus" },
          "refId": "A",
          "expr": "sum by (handler) (rate(http_requests_total{job=\"hedis-ui-backend\", handler!=\"/metrics\"}[$__rate_interval]))",
          "legendFormat": "{{handler}}",
          "instant": false,
          "range": true
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Request time p95 by route",
      "description": "95th percentile time app.py took to answer, by route.",
      "datasource": { "type": "prometheus", "uid": "hedis-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never", "spanNulls": false }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "hedis-prometheus" },
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, handler) (rate(http_request_duration_seconds_bucket{job=\"hedis-ui-backend\", handler!=\"/metrics\"}[$__rate_interval])))",
          "legendFormat": "{{handler}}",
          "instant": false,
          "range": true
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "4xx per route",
      "description": "Requests per second answered with a 4xx status, by route.",
      "datasource": { "type": "prometheus", "uid": "hedis-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never", "spanNulls": false }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "hedis-prometheus" },
          "refId": "A",
          "expr": "sum by (handler) (rate(http_requests_total{job=\"hedis-ui-backend\", status=\"4xx\"}[$__rate_interval]))",
          "legendFormat": "{{handler}}",
          "instant": false,
          "range": true
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "5xx per route",
      "description": "Requests per second answered with a 5xx status, by route.",
      "datasource": { "type": "prometheus", "uid": "hedis-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never", "spanNulls": false }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
