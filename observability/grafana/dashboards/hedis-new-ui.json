    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Star calculations by endpoint and outcome",
      "description": "Star rating calculations per interval, by endpoint and outcome.",
      "datasource": { "type": "prometheus", "uid": "hedis-prometheus" },
      "interval": "5m",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 31 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "bars", "fillOpacity": 80, "lineWidth": 1, "showPoints": "never", "stacking": { "mode": "normal", "group": "A" } }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "hedis-prometheus" },
          "refId": "A",
          "expr": "sum by (endpoint, outcome) (increase(hedis_ui_star_calculations_total[$__interval]))",
          "legendFormat": "{{endpoint}} {{outcome}}",
          "instant": false,
          "range": true
        }
      ]
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Star calculation time p95",
      "description": "95th percentile time of a star rating calculation, by endpoint.",
      "datasource": { "type": "prometheus", "uid": "hedis-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 31 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never", "spanNulls": false }
