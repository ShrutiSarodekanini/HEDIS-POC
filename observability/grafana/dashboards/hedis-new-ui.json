      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "hedis-prometheus" },
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, endpoint) (rate(hedis_ui_star_calculation_seconds_bucket[$__rate_interval])))",
          "legendFormat": "{{endpoint}}",
          "instant": false,
          "range": true
        }
      ]
    },
    {
      "id": 16,
      "type": "bargauge",
      "title": "Star calculations by measure (range)",
      "description": "Star rating calculations in the selected time range, by measure.",
      "datasource": { "type": "prometheus", "uid": "hedis-prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 39 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": { "mode": "absolute", "steps": [ { "color": "blue", "value": null } ] }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "hedis-prometheus" },
          "refId": "A",
          "expr": "sum by (measure_id) (increase(hedis_ui_star_calculations_total[$__range]))",
          "legendFormat": "{{measure_id}}",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "Evidence generations by outcome",
      "description": "Evidence documents app.py generated per interval, by outcome.",
      "datasource": { "type": "prometheus", "uid": "hedis-prometheus" },
      "interval": "5m",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 39 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "bars", "fillOpacity": 80, "lineWidth": 1, "showPoints": "never", "stacking": { "mode": "normal", "group": "A" } }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "ok" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } } ] },
          { "matcher": { "id": "byName", "options": "error" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } } ] },
          { "matcher": { "id": "byName", "options": "not_found" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } } ] },
          { "matcher": { "id": "byName", "options": "bad_request" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } } ] },
          { "matcher": { "id": "byName", "options": "unprocessable" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } } ] }
        ]
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "hedis-prometheus" },
          "refId": "A",
          "expr": "sum by (outcome) (increase(hedis_ui_evidence_generations_total[$__interval]))",
          "legendFormat": "{{outcome}}",
          "instant": false,
          "range": true
        }
      ]
    },
