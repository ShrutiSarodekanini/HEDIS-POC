          "range": true
        }
      ]
    },
    {
      "id": 20,
      "type": "stat",
      "title": "Gaps processed (range)",
      "description": "Gaps the gap automation processed in the selected time range.",
      "datasource": { "type": "prometheus", "uid": "hedis-prometheus" },
      "gridPos": { "h": 8, "w": 4, "x": 12, "y": 47 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "No data",
          "mappings": [ { "type": "special", "options": { "match": "null+nan", "result": { "text": "No data", "color": "text", "index": 0 } } } ],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "blue", "value": null } ] }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background", "graphMode": "none", "textMode": "value", "justifyMode": "auto", "orientation": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "hedis-prometheus" },
          "refId": "A",
          "expr": "sum(increase(hedis_ui_process_gaps_gaps_total[$__range])) or vector(0)",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 21,
      "type": "text",
      "title": "AI calls",
