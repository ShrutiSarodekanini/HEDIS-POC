{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "FastAPI: data_ingestion (Debug Console)",
      "type": "python",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "services.data_ingestion.main:app",
        "--host",
        "0.0.0.0",
        "--port",
        "8010",
        "--reload"
      ],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "internalConsole",
      "redirectOutput": true,
      "justMyCode": true
    }
  ]
}
