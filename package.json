{
  "name": "hedis-poc-aligned-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "Root orchestrator for HEDIS-POC aligned multi-service structure",
  "scripts": {
    "backend:install": "npm --prefix services/measure_calc/engine install",
    "backend:build": "npm --prefix services/measure_calc/engine run build",
    "backend:test": "npm --prefix services/measure_calc/engine run test",
    "backend:test:integration": "npm --prefix services/measure_calc/engine run test:integration",
    "backend:cli": "npm --prefix services/measure_calc/engine run cli --",
    "backend:gaps": "npm --prefix services/measure_calc/engine run cli -- gaps",
    "ui:install": "npm --prefix ui/frontend install",
    "ui:dev": "npm --prefix ui/frontend run dev",
    "ui:build": "npm --prefix ui/frontend run build",
    "ui:test": "npm --prefix ui/frontend run test",
    "ui:lint": "npm --prefix ui/frontend run lint"
  }
}
