DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/fhir?options=-csearch_path%3Dhedis
OPENROUTER_API_KEY=
EXTRACTION_MODEL=recursive/flint-v1.0:free
EXTRACTION_MAX_OUTPUT_TOKENS=32768
DATASETS_BASE_DIR=./datasets
FHIR_VALIDATOR_JAR=
VALIDATION_REQUIRE_EXTERNAL=false
# Run independent FQM measures in parallel; lower this value on machines with limited memory.
INTEGRATION_ENGINE_WORKERS=2

# Frontend (Vite) - loaded from this same repo-root .env
VITE_APP_NAME=HEDIS
VITE_API_BASE_URL=/api
VITE_API_TIMEOUT_MS=15000
VITE_API_OPENAPI_PATH=/openapi.json
VITE_DASHBOARD_CATALOG_PATH=/star-rating/catalog
VITE_DASHBOARD_SUMMARY_PATH=/star-dashboard/calculate
VITE_DASHBOARD_DEFAULT_MEASURE_ID=BCS-E
VITE_INTEGRATION_SEED_PATH=/star-dashboard/seed-sample-data
VITE_INTEGRATION_PROCESS_PATH=/automation/process-gaps
VITE_DEFAULT_USER_NAME=Local Reviewer
VITE_DEFAULT_USER_ROLE=Clinical Abstractor
VITE_BACKEND_URL=http://127.0.0.1:8000
VITE_QUALITY_BACKEND_URL=http://127.0.0.1:8000