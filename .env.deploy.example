# Copy to .env.deploy (ignored by git) and fill in. Read after .env by docker-compose.deploy.yml, so these win.
# host.docker.internal reaches the Postgres running on this machine; use a separate schema for the containers.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@host.docker.internal:5432/HEDISPOCDB?options=-csearch_path%3Dhedis_deploy
RABBITMQ_USER=
RABBITMQ_PASSWORD=
# Optional, for run_containers.ps1 -Observability: Grafana admin password (default admin), the password of the
# read-only login from observability/grafana/readonly_role.sql, and GRAFANA_ANONYMOUS=false to make everyone sign in
# (default true). Uncomment only to override .env: an empty value here replaces the one in .env.
# GRAFANA_ADMIN_PASSWORD=
# GRAFANA_DB_PASSWORD=
# GRAFANA_ANONYMOUS=
