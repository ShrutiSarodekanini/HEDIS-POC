# Copy to .env.deploy (ignored by git) and fill in with Azure values.
# This file overrides .env for containerized deployment.

# Database
DATABASE_URL=postgresql+psycopg://hedis_app:__DB_PASSWORD__@__AZURE_POSTGRES_HOST__:5432/__AZURE_POSTGRES_DB__?sslmode=require&options=-csearch_path%3Dhedis

# Application storage
EVIDENCE_STORAGE_DIR=/data/generated_evidence
INTAKE_STORE_DIR=/data/intake_store
INTEGRATION_WORK_DIR=/data/work
INTEGRATION_EVIDENCE_DIR=/app/data/evidence_store
DATASETS_BASE_DIR=/app/datasets
LOG_DIR=/app/logs

# Document intake and OCR
FILE_ENCRYPTION_KEY=__FILE_ENCRYPTION_KEY__
INTAKE_MAX_UPLOAD_MB=25
TESSERACT_CMD=tesseract
OCR_LOW_CONFIDENCE=0.75
OCR_HANDWRITING_CONFIDENCE=0.55
OLLAMA_URL=https://__OLLAMA_INTERNAL_FQDN__
VISION_MODEL=medgemma:4b
INTAKE_ACTOR=document_intake
INTAKE_VIRUS_SCAN=0
INTAKE_SKIP_SCAN=0
INTAKE_REQUIRE_SCAN=0

# Optional external FHIR validation
FHIR_VALIDATOR_JAR=
VALIDATION_REQUIRE_EXTERNAL=false

# Evidence extraction
OPENROUTER_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_API_KEY=__OPENROUTER_API_KEY__
EXTRACTION_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
EXTRACTION_TIMEOUT_S=300
EXTRACTION_MAX_OUTPUT_TOKENS=32768
EXTRACTION_TOKEN_BUDGET=6000
EXTRACTION_MIN_CONFIDENCE=0.3
EXTRACTION_MAX_EXCERPT_CHARS=200
EXTRACTION_ACTOR=evidence_extraction
EXTRACTION_DATA_CLASS=synthetic
EXTRACTION_PROVIDER=openrouter
EXTRACTION_PROVIDER_MODE=hosted
EXTRACTION_PROVIDER_HAS_BAA=false
EXTRACTION_PROVIDER_ALLOWED_DATA_CLASSES=synthetic

# Integration and measure engine
INTEGRATION_ACTOR=integration
INTEGRATION_REVIEWER=azure-reviewer
INTEGRATION_MEASUREMENT_YEAR=2026
INTEGRATION_ENGINE_CHUNK=50
INTEGRATION_NODE_HEAP_MB=4096
INTEGRATION_ENGINE_WORKERS=2
AI_EVIDENCE_AUTO_LIMIT=0
INTEGRATION_ALLOW_RESET=0

# Gap prioritization
GAP_PRIORITY_RULES=/app/services/gap_priority/priority_rules.yaml
GAP_PRIORITY_TIMEZONE=UTC
GAP_PRIORITY_ACTOR=gap_priority

# Automatic gap processing
AUTO_GAP_AUTOMATION=true
AUTO_GAP_AUTOMATION_INTERVAL_SECONDS=30

# Initial administrator
HEDIS_BOOTSTRAP_ADMIN_EMAIL=__BOOTSTRAP_ADMIN_EMAIL__
HEDIS_BOOTSTRAP_ADMIN_PASSWORD=__BOOTSTRAP_ADMIN_PASSWORD__

# Frontend build-time configuration
VITE_APP_NAME=HEDIS
VITE_API_BASE_URL=/api
VITE_API_TIMEOUT_MS=15000
VITE_API_OPENAPI_PATH=/openapi.json
VITE_DASHBOARD_CATALOG_PATH=/star-rating/catalog
VITE_DASHBOARD_SUMMARY_PATH=/star-dashboard/calculate
VITE_DASHBOARD_DEFAULT_MEASURE_ID=BCS-E
VITE_INTEGRATION_SEED_PATH=/star-dashboard/seed-sample-data
VITE_INTEGRATION_PROCESS_PATH=/automation/process-gaps
VITE_DEFAULT_USER_NAME=Clinical Reviewer
VITE_DEFAULT_USER_ROLE=user

# Frontend runtime proxy target (used by ui/nginx.conf template)
API_UPSTREAM=http://api:8000
