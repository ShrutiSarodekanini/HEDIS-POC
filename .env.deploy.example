# Copy to .env.deploy (ignored by git) and fill in. Read after .env by docker-compose.deploy.yml, so these win.
# host.docker.internal reaches the Postgres running on this machine; use a separate schema for the containers.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@host.docker.internal:5432/HEDISPOCDB?options=-csearch_path%3Dhedis_deploy
RABBITMQ_USER=
RABBITMQ_PASSWORD=
